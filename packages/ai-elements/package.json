{
  "name": "@svadmin/ai-elements",
  "version": "0.8.0",
  "description": "Composable Svelte 5 AI interaction components for SVAdmin",
  "type": "module",
  "sideEffects": [
    "./dist/*.css",
    "./vendor/**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "!dist/**/*.test.*",
    "!dist/**/*.test-*",
    "!dist/**/*.spec.*",
    "!dist/**/*.spec-*",
    "vendor"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ai.css": {
      "svelte": "./dist/ai.css",
      "style": "./dist/ai.css",
      "import": "./dist/ai.css",
      "default": "./dist/ai.css"
    },
    "./components/*.svelte": {
      "types": "./dist/components/*.svelte.d.ts",
      "svelte": "./dist/components/*.svelte",
      "default": "./dist/components/*.svelte"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "svelte": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./parity": {
      "types": "./dist/parity-manifest.d.ts",
      "default": "./dist/parity-manifest.js"
    },
    "./ai.theme.css": {
      "style": "./dist/ai.theme.css",
      "default": "./dist/ai.theme.css"
    }
  },
  "peerDependencies": {
    "@svadmin/core": "workspace:*",
    "@tanstack/svelte-query": "^6.1.48",
    "svelte": "^5.56.10"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "@lucide/svelte": "^1.35.0",
    "@rive-app/webgl2": "^2.41.0",
    "@sinclair/typebox": "^0.34.52",
    "@xyflow/svelte": "^1.6.5",
    "type-fest": "^4.41.0",
    "clsx": "^2.1.1",
    "@floating-ui/dom": "^1.7.4",
    "@shikijs/langs": "^3.17.1",
    "@shikijs/themes": "^3.17.1",
    "esm-env": "^1.2.2",
    "katex": "^0.16.22",
    "marked": "^16.2.1",
    "mermaid": "^11.11.0",
    "rehype-harden": "^1.1.8",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-cjk-friendly": "^2.0.1",
    "remark-cjk-friendly-gfm-strikethrough": "^2.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.13.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "@streamdown-svelte/plugin-core": "1.0.0",
    "@streamdown-svelte/remend": "1.3.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.12",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/bun": "^1.4.2",
    "happy-dom": "^20.11.12",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "node ../../scripts/build-migrated-ui.mjs ai-elements && node ../../scripts/build-native-classnames.mjs ai-elements && node ../../node_modules/@sveltejs/package/svelte-package.js -i src -o dist && bun scripts/clean-dist.ts",
    "check": "svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run --config ./vitest.config.ts && bun test scripts/clean-dist.test.ts scripts/audit-upstream-parity.test.ts",
    "audit:upstream": "bun scripts/audit-upstream-parity.ts",
    "styles:migrated:check": "node ../../scripts/build-migrated-ui.mjs ai-elements --check"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "zuohuadong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibeunion/svadmin.git",
    "directory": "packages/ai-elements"
  }
}
