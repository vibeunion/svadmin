{
  "name": "@svadmin/supabase",
  "version": "0.13.1",
  "description": "Supabase adapters — DataProvider, AuthProvider, LiveProvider, AuditHandler",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/vitest.config.*",
    "!src/**/setupTest.*"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./supacloud": {
      "types": "./src/supacloud.ts",
      "default": "./src/supacloud.ts"
    }
  },
  "peerDependencies": {
    "@svadmin/core": "workspace:*",
    "@supabase/supabase-js": "^2.112.4",
    "@refinedev/supabase": "^6.0.2",
    "@supacloud/js": "^0.23.1"
  },
  "license": "MIT",
  "author": "zuohuadong",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/svadmin.git",
    "directory": "packages/supabase"
  },
  "homepage": "https://github.com/vibeunion/svadmin#readme",
  "bugs": {
    "url": "https://github.com/vibeunion/svadmin/issues"
  },
  "peerDependenciesMeta": {
    "@svadmin/core": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    },
    "@refinedev/supabase": {
      "optional": true
    },
    "@supacloud/js": {
      "optional": true
    }
  },
  "dependencies": {
    "@svadmin/refine-adapter": "workspace:*"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.4"
  }
}
