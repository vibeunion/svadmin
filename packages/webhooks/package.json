{
  "name": "@svadmin/webhooks",
  "version": "0.2.4",
  "description": "Enterprise outgoing webhook dispatcher and HMAC-SHA256 signature suite for svadmin",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.*",
    "!src/**/*.spec.*"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "peerDependencies": {
    "@svadmin/core": "workspace:*"
  },
  "keywords": [
    "svadmin",
    "webhooks",
    "hmac",
    "signature",
    "dispatcher",
    "events",
    "integrations"
  ],
  "license": "MIT",
  "author": "zuohuadong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibeunion/svadmin.git",
    "directory": "packages/webhooks"
  },
  "homepage": "https://github.com/vibeunion/svadmin#readme",
  "bugs": {
    "url": "https://github.com/vibeunion/svadmin/issues"
  },
  "svadmin": {
    "capabilities": [
      "webhooks",
      "events"
    ],
    "core": "^0.55.0",
    "stability": "stable",
    "migration": null
  }
}
