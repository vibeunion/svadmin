{
  "name": "@svadmin/ui",
  "version": "0.73.0",
  "description": "Pre-built admin UI components — AdminApp, AutoTable, AutoForm, Sidebar, Layout",
  "type": "module",
  "sideEffects": [
    "./dist/app.css",
    "./dist/app.theme.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test-*",
    "!dist/**/*.spec.*",
    "!dist/**/*.spec-*",
    "!dist/**/*.type-test.*",
    "THIRD_PARTY_NOTICES.md",
    "styles-compatibility.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rendering": {
      "types": "./dist/rendering/index.d.ts",
      "svelte": "./dist/rendering/index.js",
      "default": "./dist/rendering/index.js"
    },
    "./app.css": {
      "svelte": "./dist/app.css",
      "import": "./dist/app.css",
      "style": "./dist/app.css",
      "default": "./dist/app.css"
    },
    "./app.theme.css": {
      "style": "./dist/app.theme.css",
      "default": "./dist/app.theme.css"
    },
    "./editor-config": {
      "types": "./dist/editor-config.svelte.d.ts",
      "svelte": "./dist/editor-config.svelte.js",
      "default": "./dist/editor-config.svelte.js"
    },
    "./components/*.svelte": {
      "types": "./dist/components/*.svelte.d.ts",
      "svelte": "./dist/components/*.svelte",
      "default": "./dist/components/*.svelte"
    },
    "./components/*": "./dist/components/*",
    "./design-contract": {
      "types": "./dist/design-contract.d.ts",
      "default": "./dist/design-contract.js"
    },
    "./recipes": {
      "types": "./dist/recipes.d.ts",
      "default": "./dist/recipes.js"
    }
  },
  "peerDependencies": {
    "@svadmin/core": "workspace:*",
    "@tanstack/svelte-query": "^6.1.48",
    "isomorphic-dompurify": "^3.23.0",
    "svelte": "^5.56.10"
  },
  "peerDependenciesMeta": {
    "isomorphic-dompurify": {
      "optional": true
    },
    "@svadmin/editor": {
      "optional": true
    },
    "@svadmin/core": {
      "optional": true
    },
    "@tanstack/svelte-query": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@floating-ui/dom": "^1.8.0",
    "@lucide/svelte": "^1.35.0",
    "@svar-ui/svelte-core": "^2.6.0",
    "@svar-ui/svelte-filemanager": "^2.6.0",
    "@tanstack/svelte-store": "^0.12.1",
    "@tanstack/svelte-table": "^9.2.3",
    "@tanstack/table-core": "^9.2.3",
    "bits-ui": "^2.19.0",
    "devframe": "1.0.0",
    "svelte-sonner": "^1.2.1",
    "clsx": "^2.1.1"
  },
  "license": "MIT",
  "author": "zuohuadong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibeunion/svadmin.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/vibeunion/svadmin#readme",
  "bugs": {
    "url": "https://github.com/vibeunion/svadmin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.12",
    "@svadmin/ai-elements": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "happy-dom": "^20.11.12",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.1",
    "vitest": "^4.1.11",
    "@pandacss/dev": "1.12.1"
  },
  "scripts": {
    "build": "bun run build:styles && node ../../node_modules/@sveltejs/package/svelte-package.js -i src -o dist && node scripts/build-static-css.mjs && node scripts/postbuild-css.mjs",
    "test": "vitest run --config ./vitest.config.ts",
    "test:css": "node --experimental-strip-types --test scripts/static-css.test.mjs scripts/panda-css.test.mjs scripts/panda-css-layers.test.mjs scripts/panda-css-isolation.test.mjs scripts/conditional-css.test.mjs scripts/primitive-recipes.test.mjs scripts/primitive-css-layers.test.mjs scripts/native-css-entries.test.mjs scripts/panda-primitive-runtime.test.mjs ../../scripts/no-tailwind-contract.test.mjs scripts/retire-primitive-fallbacks.test.mjs",
    "build:styles": "panda codegen && panda cssgen --outfile src/styled-system/styles.css && node scripts/flatten-panda-css.mjs && node scripts/prepare-panda-runtime.mjs && node ../../scripts/build-migrated-ui.mjs ui && node ../../scripts/build-native-classnames.mjs ui",
    "styles:migrated:check": "node ../../scripts/build-migrated-ui.mjs ui --check"
  }
}
