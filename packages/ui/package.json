{
  "name": "@svadmin/ui",
  "version": "0.76.0",
  "description": "Pre-built admin UI components — AdminApp, AutoTable, AutoForm, Sidebar, Layout",
  "type": "module",
  "sideEffects": [
    "./dist/app.css",
    "./dist/app.theme.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test-*",
    "!dist/**/*.spec.*",
    "!dist/**/*.spec-*",
    "!dist/**/*.type-test.*",
    "THIRD_PARTY_NOTICES.md",
    "styles-compatibility.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rendering": {
      "types": "./dist/rendering/index.d.ts",
      "svelte": "./dist/rendering/index.js",
      "default": "./dist/rendering/index.js"
    },
    "./app.css": {
      "svelte": "./dist/app.css",
      "import": "./dist/app.css",
      "style": "./dist/app.css",
      "default": "./dist/app.css"
    },
    "./app.theme.css": {
      "style": "./dist/app.theme.css",
      "default": "./dist/app.theme.css"
    },
    "./editor-config": {
      "types": "./dist/editor-config.svelte.d.ts",
      "svelte": "./dist/editor-config.svelte.js",
      "default": "./dist/editor-config.svelte.js"
    },
    "./components/*.svelte": {
      "types": "./dist/components/*.svelte.d.ts",
      "svelte": "./dist/components/*.svelte",
      "default": "./dist/components/*.svelte"
    },
    "./components/*": "./dist/components/*",
    "./code-editor": {
      "types": "./dist/components/CodeEditor.svelte.d.ts",
      "svelte": "./dist/components/CodeEditor.svelte",
      "default": "./dist/components/CodeEditor.svelte"
    },
    "./code-editor/presets": {
      "types": "./dist/components/code-editor-presets.d.ts",
      "default": "./dist/components/code-editor-presets.js"
    },
    "./json-editor": {
      "types": "./dist/components/JsonEditor.svelte.d.ts",
      "svelte": "./dist/components/JsonEditor.svelte",
      "default": "./dist/components/JsonEditor.svelte"
    },
    "./qr-code": {
      "types": "./dist/components/QRCode.svelte.d.ts",
      "svelte": "./dist/components/QRCode.svelte",
      "default": "./dist/components/QRCode.svelte"
    },
    "./design-contract": {
      "types": "./dist/design-contract.d.ts",
      "default": "./dist/design-contract.js"
    },
    "./recipes": {
      "types": "./dist/recipes.d.ts",
      "default": "./dist/recipes.js"
    },
    "./component-registry": {
      "types": "./dist/component-registry.d.ts",
      "default": "./dist/component-registry.js"
    }
  },
  "peerDependencies": {
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/lang-sql": "^6.0.0",
    "@svadmin/core": "workspace:*",
    "@tanstack/svelte-query": "^6.1.48",
    "codemirror": "^6.0.0",
    "isomorphic-dompurify": "^3.23.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.56.10",
    "svelte-codemirror-editor": "^2.1.0",
    "svelte-jsoneditor": "^3.13.0"
  },
  "peerDependenciesMeta": {
    "isomorphic-dompurify": {
      "optional": true
    },
    "@svadmin/editor": {
      "optional": true
    },
    "@svadmin/core": {
      "optional": true
    },
    "@tanstack/svelte-query": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "codemirror": {
      "optional": true
    },
    "qrcode": {
      "optional": true
    },
    "svelte-codemirror-editor": {
      "optional": true
    },
    "@codemirror/lang-javascript": {
      "optional": true
    },
    "@codemirror/lang-json": {
      "optional": true
    },
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/lang-sql": {
      "optional": true
    },
    "svelte-jsoneditor": {
      "optional": true
    }
  },
  "dependencies": {
    "@svadmin/devtools-contract": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@floating-ui/dom": "^1.8.0",
    "esm-env": "^1.2.2",
    "@lucide/svelte": "^1.35.0",
    "@svar-ui/svelte-core": "^2.6.0",
    "@svar-ui/svelte-filemanager": "^2.6.0",
    "@tanstack/svelte-store": "^0.12.1",
    "@tanstack/svelte-table": "^9.2.3",
    "@tanstack/table-core": "^9.2.3",
    "bits-ui": "^2.19.0",
    "cn": "^0.2.4",
    "devframe": "1.0.0",
    "tailwind-variants": "^3.3.1",
    "svelte-sonner": "^1.2.1"
  },
  "license": "MIT",
  "author": "zuohuadong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibeunion/svadmin.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/vibeunion/svadmin#readme",
  "bugs": {
    "url": "https://github.com/vibeunion/svadmin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@happy-dom/global-registrator": "^20.11.12",
    "@svadmin/ai-elements": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/qrcode": "^1.5.6",
    "codemirror": "^6.0.2",
    "happy-dom": "^20.11.12",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.1",
    "qrcode": "^1.5.4",
    "shadcn-svelte": "^1.7.0",
    "svelte-codemirror-editor": "^2.1.0",
    "svelte-jsoneditor": "^3.13.0",
    "tailwindcss": "4.3.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "bun run build:styles && node ../../node_modules/@sveltejs/package/svelte-package.js -i src -o dist && node scripts/build-static-css.mjs && node scripts/postbuild-css.mjs",
    "shadcn": "shadcn-svelte --help",
    "shadcn:add": "shadcn-svelte add --cwd shadcn --no-deps-install",
    "test": "vitest run --config ./vitest.config.ts",
    "test:css": "node --experimental-strip-types --test scripts/static-css.test.mjs scripts/conditional-css.test.mjs scripts/native-css-entries.test.mjs scripts/tailwind-recipes.test.mjs ../../scripts/no-tailwind-contract.test.mjs",
    "build:styles": "bun run build:tailwind && node ../../scripts/build-native-classnames.mjs ui",
    "build:tailwind": "tailwindcss -i styles/tailwind.css -o src/styles/tailwind.generated.css"
  }
}
