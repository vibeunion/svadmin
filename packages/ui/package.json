{
  "name": "@svadmin/ui",
  "version": "0.70.3",
  "description": "Pre-built admin UI components — AdminApp, AutoTable, AutoForm, Sidebar, Layout",
  "type": "module",
  "sideEffects": [
    "./dist/app.css",
    "./dist/app.theme.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test-*",
    "!dist/**/*.spec.*",
    "!dist/**/*.spec-*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./app.css": {
      "svelte": "./dist/app.css",
      "import": "./dist/app.css",
      "style": "./dist/app.css",
      "default": "./dist/app.css"
    },
    "./app.theme.css": {
      "style": "./dist/app.theme.css",
      "default": "./dist/app.theme.css"
    },
    "./components/*.svelte": {
      "types": "./dist/components/*.svelte.d.ts",
      "svelte": "./dist/components/*.svelte",
      "default": "./dist/components/*.svelte"
    },
    "./components/*": "./dist/components/*"
  },
  "peerDependencies": {
    "@svadmin/core": "workspace:*",
    "@tanstack/svelte-query": "^6.1.48",
    "isomorphic-dompurify": "^3.23.0",
    "svelte": "^5.56.10"
  },
  "peerDependenciesMeta": {
    "isomorphic-dompurify": {
      "optional": true
    },
    "@svadmin/editor": {
      "optional": true
    },
    "@svadmin/core": {
      "optional": true
    },
    "@tanstack/svelte-query": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@floating-ui/dom": "^1.8.0",
    "@lucide/svelte": "^1.35.0",
    "@tanstack/svelte-store": "^0.12.1",
    "@tanstack/svelte-table": "^9.2.3",
    "@tanstack/table-core": "^9.2.3",
    "bits-ui": "^2.19.0",
    "cn": "^0.2.4",
    "svelte-sonner": "^1.2.1"
  },
  "license": "MIT",
 "author": "zuohuadong",
 "repository": {
   "type": "git",
   "url": "git+https://github.com/vibeunion/svadmin.git",
   "directory": "packages/ui"
 },
  "homepage": "https://github.com/vibeunion/svadmin#readme",
  "bugs": {
    "url": "https://github.com/vibeunion/svadmin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.12",
    "@svadmin/ai-elements": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/node": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "happy-dom": "^20.11.12",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "node ../../node_modules/@sveltejs/package/svelte-package.js -i src -o dist && node scripts/build-static-css.mjs && node scripts/postbuild-css.mjs",
    "test": "vitest run --config ./vitest.config.ts",
    "test:css": "node --test scripts/static-css.test.mjs"
  }
}
