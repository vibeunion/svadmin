{
  "name": "@svadmin/lite",
  "version": "0.5.0",
  "description": "SSR-first lightweight admin UI for @svadmin with optional progressive enhancement",
  "type": "module",
  "sideEffects": [
    "./dist/lite.css",
    "./dist/enhance.js"
  ],
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.test.*",
    "!dist/**/*.test-*",
    "!dist/**/*.spec.*",
    "!dist/**/*.spec-*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*.svelte": {
      "types": "./dist/components/*.svelte.d.ts",
      "svelte": "./dist/components/*.svelte",
      "default": "./dist/components/*.svelte"
    },
    "./components/*": "./dist/components/*",
    "./enhance.js": {
      "import": "./dist/enhance.js",
      "default": "./dist/enhance.js"
    },
    "./lite.css": {
      "svelte": "./dist/lite.css",
      "style": "./dist/lite.css",
      "import": "./dist/lite.css",
      "default": "./dist/lite.css"
    },
    "./src/lite.css": {
      "svelte": "./dist/lite.css",
      "style": "./dist/lite.css",
      "import": "./dist/lite.css",
      "default": "./dist/lite.css"
    }
  },
  "peerDependencies": {
    "svelte": "^5.56.10",
    "@svadmin/core": ">=0.34.2 <0.46.0",
    "@sveltejs/kit": "^2.70.3"
  },
  "dependencies": {
    "@lucide/svelte": "^1.35.0",
    "@sinclair/typebox": "^0.34.52"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@happy-dom/global-registrator": "^20.11.12",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.4.2",
    "happy-dom": "^20.11.12",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "node ../../node_modules/@sveltejs/package/svelte-package.js -i src -o dist && bun ../../scripts/copy-package-assets.ts static/enhance.js dist/enhance.js",
    "test": "bun run test:components && bun run test:server && bun run test:security",
    "test:components": "vitest run --config ./vitest.config.ts",
    "test:server": "bun test ./src/schema-generator.test.ts ./src/server-adapter.test.ts ./src/fragment-id.test.ts ./src/compatibility.test.ts ./src/ie11-ssr-contract.test.ts",
    "test:security": "vitest run --config ./src/security.test.config.ts"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "zuohuadong",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/svadmin.git",
    "directory": "packages/lite"
  }
}
