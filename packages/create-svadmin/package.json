{
  "name": "@svadmin/create",
  "version": "0.21.0",
  "description": "Scaffolding tool for svadmin projects",
  "type": "module",
  "bin": {
    "create-svadmin": "./dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "guidance",
    "scaffold-manifest.json"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm",
    "test": "bun test src",
    "check:compat": "bun ../../scripts/check-create-svadmin-compat.ts",
    "sync-template": "bun src/sync-template.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "prompts": "^2.4.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^7.0.2",
    "@svadmin/core": "workspace:*"
  },
  "keywords": [
    "svadmin",
    "create",
    "scaffold",
    "cli"
  ],
  "author": "zuohuadong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/svadmin.git",
    "directory": "packages/create-svadmin"
  }
}
