{
  "name": "@svadmin/pocketbase",
  "version": "0.10.4",
  "description": "PocketBase adapters — DataProvider, AuthProvider, LiveProvider for svadmin",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/vitest.config.*",
    "!src/**/setupTest.*"
  ],
  "main": "src/index.ts",
