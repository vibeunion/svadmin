      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "peerDependencies": {
    "@svadmin/core": "workspace:*",
    "pocketbase": ">=0.28.0"
  },
  "keywords": [
    "svadmin",
    "pocketbase",
    "data-provider",
    "auth-provider",
    "live-provider"
  ],
  "license": "MIT",
  "author": "zuohuadong",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/svadmin.git",
    "directory": "packages/pocketbase"
  },
  "homepage": "https://github.com/vibeunion/svadmin#readme",
  "bugs": {
    "url": "https://github.com/vibeunion/svadmin/issues"
  },
  "peerDependenciesMeta": {
    "@svadmin/core": {
      "optional": true
    },
    "pocketbase": {
      "optional": true
    }
  }
