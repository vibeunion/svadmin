{
  "name": "@svadmin/meilisearch",
  "version": "0.3.3",
  "description": "Meilisearch instant search & faceted DataProvider for svadmin",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.*",
    "!src/**/*.spec.*"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "peerDependencies": {
    "@svadmin/core": "workspace:*"
  },
  "keywords": [
    "svadmin",
    "meilisearch",
    "search",
    "instant-search",
    "faceted-search",
    "data-provider"
  ],
  "license": "MIT",
  "author": "zuohuadong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibeunion/svadmin.git",
    "directory": "packages/meilisearch"
  },
  "homepage": "https://github.com/vibeunion/svadmin#readme",
  "bugs": {
    "url": "https://github.com/vibeunion/svadmin/issues"
  },
  "svadmin": {
    "capabilities": [
      "data"
    ],
    "core": "^0.55.0",
    "stability": "stable",
    "migration": null
  }
}
