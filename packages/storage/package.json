{
  "name": "@svadmin/storage",
  "version": "0.2.6",
  "description": "Storage adapters — S3, Cloudflare R2, and in-memory storage provider for svadmin",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.*",
    "!src/**/*.spec.*"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "peerDependencies": {
    "@svadmin/core": "workspace:*"
  },
  "keywords": [
    "svadmin",
    "storage",
    "s3",
    "r2",
    "storage-provider"
  ],
  "license": "MIT",
  "author": "zuohuadong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibeunion/svadmin.git",
    "directory": "packages/storage"
  },
  "homepage": "https://github.com/vibeunion/svadmin#readme",
  "bugs": {
    "url": "https://github.com/vibeunion/svadmin/issues"
  },
  "svadmin": {
    "capabilities": [
      "storage"
    ],
    "core": "^0.55.0",
    "stability": "stable",
    "migration": null
  }
}
