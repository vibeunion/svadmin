{
  "name": "@svadmin/refine-adapter",
  "version": "0.12.2",
  "description": "Universal Refine DataProvider adapter for svadmin",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/vitest.config.*",
    "!src/**/setupTest.*"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "peerDependencies": {
    "@svadmin/core": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibeunion/svadmin.git",
    "directory": "packages/refine-adapter"
  },
  "peerDependenciesMeta": {
    "@svadmin/core": {
      "optional": true
    }
  },
  "svadmin": {
    "capabilities": [
      "adapter",
      "refine-bridge"
    ],
    "core": "^0.55.0",
    "stability": "stable",
    "migration": null
  }
}
