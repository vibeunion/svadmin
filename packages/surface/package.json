{
  "name": "@svadmin/surface",
  "version": "0.8.18",
  "description": "Validated declarative surfaces for svadmin dashboards",
  "type": "module",
  "sideEffects": ["./dist/styles/editor.css"],
  "files": ["dist", "README.md", "compatibility.json", "!dist/**/*.test.*", "!dist/**/*.spec.*"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./svelte": { "types": "./dist/svelte.d.ts", "svelte": "./dist/svelte.js", "default": "./dist/svelte.js" },
    "./editor.css": { "style": "./dist/styles/editor.css", "default": "./dist/styles/editor.css" }
  },
  "peerDependencies": {
    "@svadmin/core": ">=0.34.2 <0.52.0",
    "@svadmin/ui": ">=0.40.6 <0.72.0",
    "svelte": "^5.56.8"
  },
  "dependencies": { "@sinclair/typebox": "^0.34.52" },
  "devDependencies": {
    "@pandacss/dev": "1.12.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "happy-dom": "^20.11.12",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "styles:build": "node scripts/build-editor-styles.mjs",
    "styles:check": "node scripts/build-editor-styles.mjs --check",
    "build": "node scripts/build-editor-styles.mjs && node ../../node_modules/@sveltejs/package/svelte-package.js -i src -o dist",
    "check": "svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "license": "MIT",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "author": "zuohuadong",
  "repository": { "type": "git", "url": "git+https://github.com/vibeunion/svadmin.git", "directory": "packages/surface" },
  "homepage": "https://github.com/vibeunion/svadmin#readme",
  "bugs": { "url": "https://github.com/vibeunion/svadmin/issues" }
}
