{
  "name": "@svadmin/surface",
  "version": "0.6.2",
  "description": "Validated declarative surfaces for svadmin dashboards",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "compatibility.json",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "svelte": "./dist/svelte.js",
      "default": "./dist/svelte.js"
    }
  },
  "peerDependencies": {
    "@svadmin/core": ">=0.34.2 <0.48.0",
    "@svadmin/ui": ">=0.40.6 <0.66.0",
    "svelte": "^5.56.8"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "happy-dom": "^20.11.12",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "node ../../node_modules/@sveltejs/package/svelte-package.js -i src -o dist",
    "check": "svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "zuohuadong",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeunion/svadmin.git",
    "directory": "packages/surface"
  },
  "homepage": "https://github.com/vibeunion/svadmin#readme",
  "bugs": {
    "url": "https://github.com/vibeunion/svadmin/issues"
  }
}
