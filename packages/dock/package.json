{
  "name": "@svadmin/dock",
  "version": "0.1.0",
  "description": "Resizable split panes and dockable workspaces for svadmin",
  "type": "module",
  "files": ["dist", "README.md", "!dist/**/*.test.*", "!dist/**/*.test-*", "!dist/**/*.spec.*", "!dist/**/*.spec-*"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "svelte": "./dist/index.js", "default": "./dist/index.js" },
    "./components/*.svelte": { "types": "./dist/components/*.svelte.d.ts", "svelte": "./dist/components/*.svelte", "default": "./dist/components/*.svelte" },
    "./components/*": "./dist/components/*"
  },
  "peerDependencies": { "dockview": "^8.8.2", "paneforge": "^1.0.2", "svelte": "^5.56.10" },
  "peerDependenciesMeta": { "dockview": { "optional": true }, "paneforge": { "optional": true }, "svelte": { "optional": true } },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.4.2",
    "dockview": "^8.8.2",
    "happy-dom": "^21.0.4",
    "paneforge": "^1.0.2",
    "svelte": "5.57.1",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "node ../../node_modules/@sveltejs/package/svelte-package.js -i src -o dist",
    "check": "svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/vibeunion/svadmin.git", "directory": "packages/dock" }
}
