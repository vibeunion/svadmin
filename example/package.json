{
  "name": "svadmin-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node ../node_modules/@typescript/native/bin/tsc -p tsconfig.bun-tests.json --pretty false && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "node ../scripts/check-native-style-sources.mjs example && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "styles:migrated:check": "node ../scripts/check-native-style-sources.mjs example"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.35.0",
    "@sinclair/typebox": "^0.34.52",
    "@svadmin/core": "workspace:*",
    "@svadmin/ai-elements": "workspace:*",
    "@svadmin/editor": "workspace:*",
    "@svadmin/mcp": "workspace:*",
    "@svadmin/surface": "workspace:*",
    "@svadmin/ui": "workspace:*",
    "@tanstack/svelte-query": "^6.1.48",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "happy-dom": "^20.11.12",
    "isomorphic-dompurify": "^3.23.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
