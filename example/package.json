{
  "name": "svadmin-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node ../node_modules/@typescript/native/bin/tsc -p tsconfig.bun-tests.json --pretty false && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "node ../scripts/check-native-style-sources.mjs example && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "styles:migrated:check": "node ../scripts/check-native-style-sources.mjs example"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.71.0",
    "typebox": "^1.4.6",
    "@svadmin/core": "workspace:*",
    "@svadmin/ai-elements": "workspace:*",
    "@svadmin/editor": "workspace:*",
    "@svadmin/mcp": "workspace:*",
    "@svadmin/surface": "workspace:*",
    "@svadmin/ui": "workspace:*",
    "@tanstack/svelte-query": "^6.4.1",
    "bits-ui": "^2.20.6",
    "clsx": "^2.1.1",
    "@svadmin/charts": "workspace:*",
    "@svadmin/dock": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "happy-dom": "^21.0.4",
    "isomorphic-dompurify": "^4.7.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
