{
  "name": "svadmin",
  "private": true,
  "type": "module",
  "version": "0.5.14",
  "description": "Headless admin framework for Svelte 5 — bring your own backend",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "example",
    "docs"
  ],
  "scripts": {
    "dev": "cd example && bun run dev",
    "dev:lite": "cd packages/lite/example && bun run dev",
    "build": "bun run build:packages && bun run --cwd example build && bun run bundle:check",
    "build:example": "bun run --cwd example build",
    "check": "bun run typecheck",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "bun run check:architecture && bun run check:type-boundaries && bun run check:types && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.svelte-check.json && bun run --cwd packages/surface check && bun run --cwd packages/flow check && bun run --cwd packages/charts check && bun run --cwd packages/dock check && bun run --cwd example check && bun run --cwd packages/lite/example check",
    "check:architecture": "bun scripts/check-architecture.ts",
    "check:vibe-governance": "bun scripts/check-vibe-governance.ts",
    "check:type-boundaries": "bun scripts/check-type-boundaries.ts",
    "check:types": "bun scripts/check-type-contracts.ts",
    "check:types:dependencies": "bun scripts/check-type-coverage.ts && node node_modules/@typescript/native/bin/tsc -p tsconfig.bun-tests.json --pretty false && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.dependencies.json",
    "test": "bun scripts/run-tests.ts",
    "verify": "bun scripts/verify.ts",
    "test:e2e": "bun run playwright test",
    "audit": "bun scripts/audit-dependencies.ts",
    "theme:audit": "bun scripts/audit-theme-contrast.ts --check",
    "docs:components": "bun scripts/component-docs.ts --check",
    "docs:dev": "cd docs && bun run dev",
    "docs:build": "cd docs && bun run build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "prepare": "husky",
    "build:packages": "bun run --cwd packages/ai-elements build && bun run --cwd packages/devtools-contract build && bun run --cwd packages/app build && bun run --cwd packages/devtools build && bun run --cwd packages/ui build && bun run --cwd packages/flow build && bun run --cwd packages/charts build && bun run --cwd packages/dock build && bun run --cwd packages/surface build && bun run --cwd packages/editor build && bun run --cwd packages/lite build && bun run --cwd packages/auth-utils build && bun run --cwd packages/sso build && bun run --cwd packages/create-svadmin build",
    "bundle:check": "bun scripts/check-example-bundle.ts",
    "check:styles": "node scripts/check-style-boundary.mjs",
    "check:styles:source": "node scripts/check-style-boundary.mjs --source",
    "check:ui-style": "bun run --cwd packages/ui build && bun run --cwd packages/ui test:css",
    "check:surface-style": "bun run --cwd packages/surface build && bun run --cwd packages/surface styles:check",
    "check:openui": "bun run check:ui-style && bun run check:surface-style && bun scripts/check-style-boundary.mjs --packages=ui,surface",
    "check:lite:ssr": "bun run --cwd packages/lite/example check && bun run --cwd packages/lite/example verify:ssr",
    "pack:check": "bun scripts/check-package-packs.ts",
    "doc:sync": "bun scripts/check-doc-sync.ts",
    "check:theme-contrast": "bun scripts/audit-theme-contrast.ts --check",
    "check:parity": "bun scripts/check-parity.ts --write",
    "check:parity:verify": "bun scripts/check-parity.ts --check"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "admin",
    "admin-panel",
    "headless",
    "crud",
    "data-provider",
    "tanstack-query",
    "shadcn-svelte"
  ],
  "license": "MIT",
  "author": "zuohuadong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibeunion/svadmin.git"
  },
  "homepage": "https://github.com/vibeunion/svadmin#readme",
  "bugs": {
    "url": "https://github.com/vibeunion/svadmin/issues"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/svelte-vite": "10.6.6",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/package": "^3.0.2",
    "@types/bun": "^1.4.4",
    "@types/papaparse": "^5.5.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cac": "^7.1.0",
    "devframe": "1.3.3",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "storybook": "10.6.6",
    "svelte-check": "^4.7.8",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "typescript": "~6.0.3"
  },
  "overrides": {
    "exceljs@4.4.0>uuid": "11.1.1",
    "browserslist": "4.29.5",
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@sveltejs/kit": "3.2.0",
    "astro": "7.4.8",
    "axios": "1.21.1",
    "body-parser": "2.4.0",
    "brace-expansion": "5.0.12",
    "braces": "3.0.3",
    "deepmerge": "4.3.1",
    "devalue": "5.9.4",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "fast-uri": "4.2.3",
    "form-data": "4.0.6",
    "happy-dom": "21.0.4",
    "http-cache-semantics": "4.3.0",
    "ip-address": "10.7.6",
    "isomorphic-dompurify": "4.7.0",
    "js-yaml": "4.3.2",
    "katex": "0.19.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.2.0",
    "prosemirror-model": "1.25.13",
    "prosemirror-view": "1.42.9",
    "qs": "6.17.1",
    "sharp": "0.35.5",
    "smol-toml": "1.9.1",
    "source-map-js": "1.2.2",
    "starlight-llms-txt": "0.12.0",
    "svgo": "4.1.0",
    "svelte": "5.57.3",
    "ts-deepmerge": "8.0.0",
    "undici": "8.12.4",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "ws": "8.22.2",
    "zod": "4.6.7",
    "decode-uri-component": "0.5.1",
    "hono": "4.13.13",
    "follow-redirects": "1.16.3",
    "minimatch": "11.0.5",
    "svelte-toolbelt": "0.10.7",
    "devframe": "1.3.3"
  },
  "patchedDependencies": {
    "@refinedev/core@5.0.12": "patches/@refinedev%2Fcore@5.0.12.patch",
    "drizzle-orm@1.0.0-rc.2-63dd281": "patches/drizzle-orm@1.0.0-rc.2-63dd281.patch",
    "braces@3.0.3": "patches/braces@3.0.3.patch",
    "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch",
    "glob@7.2.3": "patches/glob@7.2.3.patch",
    "@supabase/auth-js@2.119.0": "patches/@supabase%2Fauth-js@2.119.0.patch",
    "elysia@1.4.31": "patches/elysia@1.4.31.patch",
    "@xyflow/system@0.0.84": "patches/@xyflow%2Fsystem@0.0.84.patch",
    "@xyflow/svelte@1.7.1": "patches/@xyflow%2Fsvelte@1.7.1.patch",
    "bits-ui@2.20.6": "patches/bits-ui@2.20.6.patch",
    "svelte-toolbelt@0.10.7": "patches/svelte-toolbelt@0.10.7.patch",
    "@tanstack/svelte-query@6.4.1": "patches/@tanstack%2Fsvelte-query@6.4.1.patch",
    "@tanstack/svelte-table@9.3.1": "patches/@tanstack%2Fsvelte-table@9.3.1.patch",
    "http-cache-semantics@4.3.0": "patches/http-cache-semantics@4.3.0.patch"
  },
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs",
    "example": "example"
  }
}
