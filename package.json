{
  "name": "svadmin",
  "private": true,
  "type": "module",
  "version": "0.5.14",
  "description": "Headless admin framework for Svelte 5 — bring your own backend",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "example",
    "docs"
  ],
  "scripts": {
    "dev": "cd example && bun run dev",
    "dev:lite": "cd packages/lite/example && bun run dev",
    "build": "bun run build:packages && bun run --cwd example build && bun run bundle:check",
    "build:example": "bun run --cwd example build",
    "check": "bun run typecheck",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "bun run check:types && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.svelte-check.json && bun run --cwd packages/surface check && bun run --cwd packages/flow check && bun run --cwd example check && bun run --cwd packages/lite/example check",
    "test": "bun scripts/run-tests.ts",
    "verify": "bun scripts/verify.ts",
    "test:e2e": "bun run playwright test",
    "audit": "bun audit --registry=https://registry.npmjs.org",
    "docs:dev": "cd docs && bun run dev",
    "docs:build": "cd docs && bun run build",
    "prepare": "husky",
    "build:packages": "bun run --cwd packages/ai-elements build && bun run --cwd packages/ui build && bun run --cwd packages/flow build && bun run --cwd packages/surface build && bun run --cwd packages/editor build && bun run --cwd packages/lite build && bun run --cwd packages/auth-utils build && bun run --cwd packages/sso build && bun run --cwd packages/create-svadmin build",
    "bundle:check": "bun scripts/check-example-bundle.ts",
    "check:lite:ssr": "bun run --cwd packages/lite/example check && bun run --cwd packages/lite/example verify:ssr",
    "check:lite:ie11": "bun run --cwd packages/lite test:server",
    "pack:check": "bun scripts/check-package-packs.ts",
    "doc:sync": "bun scripts/check-doc-sync.ts",
    "check:parity": "bun scripts/check-parity.ts --write",
    "check:types": "bun scripts/check-type-contracts.ts",
    "check:types:dependencies": "bun scripts/check-type-coverage.ts && node node_modules/@typescript/native/bin/tsc -p tsconfig.bun-tests.json --pretty false && svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.dependencies.json"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "admin",
    "admin-panel",
    "headless",
    "crud",
    "data-provider",
    "tanstack-query",
    "shadcn-svelte"
  ],
  "license": "MIT",
  "author": "zuohuadong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibeunion/svadmin.git"
  },
  "homepage": "https://github.com/vibeunion/svadmin#readme",
  "bugs": {
    "url": "https://github.com/vibeunion/svadmin/issues"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "svelte-check": "^4.7.6",
    "typescript-eslint": "^8.68.0",
    "@types/papaparse": "^5.5.2"
  },
  "dependencies": {
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@sveltejs/kit": "2.70.3",
    "astro": "7.2.8",
    "brace-expansion": "5.0.9",
    "cookie": "1.1.1",
    "devalue": "5.9.2",
    "dompurify": "3.4.14",
    "esbuild": "0.28.2",
    "fast-uri": "4.1.3",
    "form-data": "4.0.6",
    "happy-dom": "20.11.12",
    "isomorphic-dompurify": "3.23.0",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "prosemirror-model": "1.25.11",
    "qs": "6.16.0",
    "smol-toml": "1.8.0",
    "starlight-llms-txt": "0.11.0",
    "svgo": "4.1.0",
    "svelte": "5.56.10",
    "ts-deepmerge": "8.0.0",
    "undici": "8.10.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "ws": "8.21.3",
    "decode-uri-component": "0.5.0"
  },
  "patchedDependencies": {
    "@sveltejs/package@2.5.8": "patches/@sveltejs%2Fpackage@2.5.8.patch",
    "@refinedev/core@5.0.12": "patches/@refinedev%2Fcore@5.0.12.patch",
    "drizzle-orm@1.0.0-rc.2-63dd281": "patches/drizzle-orm@1.0.0-rc.2-63dd281.patch",
    "@sveltejs/kit@2.70.3": "patches/@sveltejs%2Fkit@2.70.3.patch",
    "@tanstack/svelte-query@6.1.48": "patches/@tanstack%2Fsvelte-query@6.1.48.patch",
    "@tanstack/svelte-table@9.2.3": "patches/@tanstack%2Fsvelte-table@9.2.3.patch",
    "@xyflow/system@0.0.81": "patches/@xyflow%2Fsystem@0.0.81.patch",
    "@xyflow/svelte@1.6.5": "patches/@xyflow%2Fsvelte@1.6.5.patch",
    "elysia@1.4.30": "patches/elysia@1.4.30.patch",
    "bits-ui@2.19.0": "patches/bits-ui@2.19.0.patch",
    "svelte-toolbelt@0.10.6": "patches/svelte-toolbelt@0.10.6.patch",
    "@supabase/auth-js@2.112.4": "patches/@supabase%2Fauth-js@2.112.4.patch"
  },
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs",
    "example": "example"
  }
}
