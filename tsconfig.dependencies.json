{
  // 依赖声明检查：校验“我们的代码如何消费第三方类型”，而不是审查第三方 .d.ts 内部。
  // - @dagrejs/dagre / dockview-core 当前发布的声明在 skipLibCheck:false 下自相矛盾
  //   （dagre 引用 graphlib 不存在的 Node；dockview 的接口与实现签名不一致），上游未修复；
  //   我们自己的源码仍由 tsconfig.json / browser / bun-tests 以 skipLibCheck:false 严格检查。
  // - .svelte 组件的可选 prop 语义与 svelte-check 项目保持一致，避免同一代码在两条
  //   检查链上得出相反结论。
  // - 测试文件由 browser / bun-tests 项目覆盖，这里只检查发布产物消费路径。
  "extends": "./tsconfig.browser.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "exclude": [
    "node_modules",
    "dist",
    "packages/*/src/**/*.test.*",
    "packages/*/src/**/*.spec.*",
    "example/src/**/*.test.*",
    "example/src/**/*.spec.*"
  ]
}
