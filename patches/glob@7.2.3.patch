diff --git a/common.js b/common.js
index 424c46e1dab1be6b6e357b0620d3efbc059ee0b8..bedc130a9ea39aad5d7f6f0578fc5ffda62d025c 100644
--- a/common.js
+++ b/common.js
@@ -16,6 +16,40 @@ var minimatch = require("minimatch")
 var isAbsolute = require("path-is-absolute")
 var Minimatch = minimatch.Minimatch

+// 保留 glob 7 的路径遍历语义及 set/globSet 索引对应关系。
+// 只在这个旧调用方禁用行合并，仍使用上游修复后的非递归 Matcher。
+class GlobMinimatch extends Minimatch {
+  constructor (pattern, options) {
+    super(pattern, Object.assign({}, options, {
+      optimizationLevel: 0,
+      allowWindowsEscape: true,
+      windowsPathsNoEscape: false,
+    }))
+  }
+
+  mergeRows () {}
+
+  parse (pattern) {
+    var parsed = super.parse(pattern)
+    if (typeof parsed !== 'string' || pattern === parsed)
+      return parsed
+
+    // 单字符类仍是通配节点，供 hasMagic、dot 和清理调用方判断。
+    var inClass = false
+    for (var i = 0; i < pattern.length; i++) {
+      if (pattern[i] === '\\') {
+        i++
+      } else if (pattern[i] === '[') {
+        inClass = true
+      } else if (inClass && pattern[i] === ']') {
+        var test = function (value) { return value === parsed }
+        return { pattern: pattern, test: test, testUnchecked: test }
+      }
+    }
+    return parsed
+  }
+}
+
 function alphasort (a, b) {
   return a.localeCompare(b, 'en')
 }
@@ -36,11 +70,11 @@ function ignoreMap (pattern) {
   var gmatcher = null
   if (pattern.slice(-3) === '/**') {
     var gpattern = pattern.replace(/(\/\*\*)+$/, '')
-    gmatcher = new Minimatch(gpattern, { dot: true })
+    gmatcher = new GlobMinimatch(gpattern, { dot: true })
   }

   return {
-    matcher: new Minimatch(pattern, { dot: true }),
+    matcher: new GlobMinimatch(pattern, { dot: true }),
     gmatcher: gmatcher
   }
 }
@@ -113,7 +147,7 @@ function setopts (self, pattern, options) {
   // always treat \ in patterns as escapes, not path separators
   options.allowWindowsEscape = false

-  self.minimatch = new Minimatch(pattern, options)
+  self.minimatch = new GlobMinimatch(pattern, options)
   self.options = self.minimatch.options
 }

