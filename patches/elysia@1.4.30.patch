new file mode 100644
index 0000000000000000000000000000000000000000..3922d0b9244220a90f717448f9aa2fe7b63c6f3e
--- /dev/null
+++ b/dist/standard-parse.cjs
@@ -0,0 +1,56 @@
+/** @typedef {import('./schema').StandardValidationError} StandardValidationError */
+/**
+ * @param {unknown} segment
+ * @returns {string}
+ */
+function pathSegment(segment) {
+  const key = typeof segment === 'object' && segment !== null && 'key' in segment
+    ? segment.key : segment;
+  if (typeof key !== 'string' && typeof key !== 'number' && typeof key !== 'symbol') {
+    throw new TypeError('Invalid standard schema issue path');
+  }
+  return String(key).replaceAll('~', '~0').replaceAll('/', '~1');
+}
+
+/**
+ * @param {unknown} issue
+ * @returns {StandardValidationError}
+ */
+function normalizeIssue(issue) {
+  if (typeof issue !== 'object' || issue === null || !('message' in issue)
+    || typeof issue.message !== 'string') {
+    throw new TypeError('Invalid standard schema issue');
+  }
+  const rawPath = 'path' in issue ? issue.path : undefined;
+  let path = '';
+  if (Array.isArray(rawPath)) path = rawPath.length ? `/${rawPath.map(pathSegment).join('/')}` : '';
+  else if (typeof rawPath === 'string') path = rawPath;
+  else if (rawPath !== undefined) throw new TypeError('Invalid standard schema issue path');
+  return { message: issue.message, summary: issue.message, path };
+}
+
+/**
+ * @param {unknown} response
+ * @returns {{ success: true, data: unknown, error: null } | {
+ *   success: false, data: null, error: string | undefined, errors: StandardValidationError[]
+ * }}
+ */
+function readStandardResult(response) {
+  if (response instanceof Promise) {
+    // Synchronous parsing cannot consume an asynchronous schema; Validate can.
+    void response.catch(() => {});
+    throw new TypeError('Use Validate for asynchronous standard schema validation');
+  }
+  if (typeof response !== 'object' || response === null) {
+    throw new TypeError('Invalid standard schema result');
+  }
+  if ('issues' in response && response.issues !== undefined) {
+    if (!Array.isArray(response.issues)) throw new TypeError('Invalid standard schema issues');
+    const errors = response.issues.map(normalizeIssue);
+    return { success: false, data: null, error: errors[0]?.summary, errors };
+  }
+  if (!('value' in response)) throw new TypeError('Invalid standard schema result');
+  return { success: true, data: response.value, error: null };
+}
+
+exports.readStandardResult = readStandardResult;
